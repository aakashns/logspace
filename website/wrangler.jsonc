{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "logspace-website",
  "main": "worker.ts",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/demo.mp4"],
    "not_found_handling": "none",
  },
  "observability": { "enabled": true },
}
