{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Pages are TSX rendered straight to HTML strings by src/jsx (no virtual DOM).
    "jsx": "react-jsx",
    "jsxImportSource": "#jsx",
    // The browser's modules (src/client/) import Datastar's bundle as `datastar`, which the
    // import map in views/document.tsx points at; these are its types.
    "paths": { "datastar": ["./src/client/datastar.d.ts"] }
  },
  "exclude": ["dist", "node_modules"]
}
