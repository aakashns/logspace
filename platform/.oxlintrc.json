{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": { "correctness": "error" },
  // Types are checked, not asserted: no casts (`as const` is fine), no `any`, and no `!`.
  "rules": {
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error"
  },
  "env": { "builtin": true },
  // Vendored: Datastar's bundle, minified, and its types.
  "ignorePatterns": ["public/datastar-rocket.js", "src/client/datastar.d.ts"],
  // The layers of src/ (see ../CONTRIBUTING.md), kept apart: each may only import the ones below it.
  "overrides": [
    {
      // The browser's modules run apart from the server, with Datastar alone.
      "files": ["src/client/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          { "patterns": ["./*", "../*", "#jsx/*", "effect", "effect/*", "node:*"] }
        ]
      }
    },
    {
      // Pure: no database, storage, images, HTTP, or pages.
      "files": ["src/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "**/services/**",
              "**/commands/**",
              "**/queries/**",
              "**/http/**",
              "**/views/**",
              "**/cli/**",
              "effect/sql",
              "node:fs*"
            ]
          }
        ]
      }
    },
    {
      // The read side never writes.
      "files": ["src/queries/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          { "patterns": ["**/commands/**", "**/http/**", "**/views/**", "**/cli/**"] }
        ]
      }
    },
    {
      "files": ["src/commands/**", "src/services/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          { "patterns": ["**/http/**", "**/views/**", "**/cli/**"] }
        ]
      }
    },
    {
      // Pages render what they're given; they don't fetch or write. URLs and the shapes they show
      // come from domain/.
      "files": ["src/views/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "**/services/**",
              "**/commands/**",
              "**/queries/**",
              "**/http/**",
              "**/cli/**",
              "effect/sql"
            ]
          }
        ]
      }
    },
    {
      // Public pages (and the navbar's controls) don't use the admin's, like the composer's.
      "files": ["src/views/*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "**/admin/**",
              "**/services/**",
              "**/commands/**",
              "**/queries/**",
              "**/http/**",
              "**/cli/**",
              "effect/sql"
            ]
          }
        ]
      }
    },
    {
      // Public routes only read, and show public pages.
      "files": ["src/http/public.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          { "patterns": ["**/commands/**", "**/admin/**", "**/admin.tsx", "**/cli/**"] }
        ]
      }
    },
    {
      // The admin's handlers share admin/pages.tsx; the route table (admin.tsx) is the only place
      // that imports them all.
      "files": ["src/http/admin/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "./login.tsx",
              "./config.tsx",
              "./posts.tsx",
              "./composer.tsx",
              "../admin.tsx",
              "**/cli/**"
            ]
          }
        ]
      }
    }
  ]
}
