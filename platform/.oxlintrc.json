{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": { "correctness": "error" },
  // Types are checked, not asserted: no casts (`as const` is fine), no `any`, and no `!`.
  "rules": {
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error"
  },
  "env": { "builtin": true },
  // Vendored, minified.
  "ignorePatterns": ["public/datastar.js"],
  // What each part of src/ may import (see ../CONTRIBUTING.md): routes use data and components,
  // data never uses routes or components, and pages only render. A file gets the last rule that
  // names it.
  "overrides": [
    {
      // Data doesn't know about requests or pages.
      "files": ["src/data/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "**/routes/**",
              "**/handler.ts",
              "**/handler.tsx",
              "**/components/**",
              "**/lib/http/**",
              "**/cli/**"
            ]
          }
        ]
      }
    },
    {
      // Reads never write.
      "files": [
        "src/data/**/queries.ts",
        "src/data/posts/media.ts",
        "src/data/link-previews/link-previews.ts",
        "src/data/site/files.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "**/commands.ts",
              "**/posts/files.ts",
              "**/routes/**",
              "**/handler.ts",
              "**/handler.tsx",
              "**/components/**",
              "**/lib/http/**",
              "**/cli/**"
            ]
          }
        ]
      }
    },
    {
      // Shared services don't know about requests or pages either.
      "files": ["src/lib/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "**/routes/**",
              "**/handler.ts",
              "**/handler.tsx",
              "**/components/**",
              "**/lib/http/**",
              "**/cli/**"
            ]
          }
        ]
      }
    },
    {
      // What every route shares doesn't depend on any one route.
      "files": ["src/lib/http/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": ["**/routes/**", "**/handler.ts", "**/handler.tsx", "**/cli/**"]
          }
        ]
      }
    },
    {
      // Pages render what they're given; they don't fetch or write.
      "files": [
        "src/components/**",
        "src/routes/**/page.tsx",
        "src/routes/admin/layout.tsx",
        "src/routes/index/feed.tsx",
        "src/routes/admin/fields.tsx"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "**/lib/database.ts",
              "**/lib/media-storage.ts",
              "**/lib/images.ts",
              "**/lib/public-http.ts",
              "**/queries.ts",
              "**/media.ts",
              "**/link-previews.ts",
              "**/site/files.ts",
              "**/commands.ts",
              "**/posts/files.ts",
              "**/lib/http/**",
              "**/handler.ts",
              "**/handler.tsx",
              "**/cli/**",
              "effect/sql"
            ]
          }
        ]
      }
    },
    {
      // Public pages (and the navbar's controls) don't use the admin's.
      "files": [
        "src/components/**",
        "src/routes/index/page.tsx",
        "src/routes/index/feed.tsx",
        "src/routes/post/page.tsx"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "**/lib/database.ts",
              "**/lib/media-storage.ts",
              "**/lib/images.ts",
              "**/lib/public-http.ts",
              "**/queries.ts",
              "**/media.ts",
              "**/link-previews.ts",
              "**/site/files.ts",
              "**/commands.ts",
              "**/posts/files.ts",
              "**/lib/http/**",
              "**/handler.ts",
              "**/handler.tsx",
              "**/cli/**",
              "**/admin/**",
              "effect/sql"
            ]
          }
        ]
      }
    },
    {
      // Public routes only read, and show public pages.
      "files": [
        "src/routes/index/handler.tsx",
        "src/routes/post/handler.tsx",
        "src/routes/feeds/handler.ts",
        "src/routes/site-files/handler.ts",
        "src/routes/link-images/handler.ts",
        "src/routes/assets/handler.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": ["**/commands.ts", "**/posts/files.ts", "**/admin/**", "**/cli/**"]
          }
        ]
      }
    },
    {
      // Pure: no database, storage, images, network, reads, writes, HTTP, or pages.
      "files": [
        "src/data/posts/post.ts",
        "src/data/posts/rows.ts",
        "src/data/posts/presentation.ts",
        "src/data/posts/caption.ts",
        "src/data/posts/format.ts",
        "src/data/site/site.ts",
        "src/data/site/site-images.ts",
        "src/data/link-previews/link-metadata.ts",
        "src/routes/admin/compose/form.ts",
        "src/routes/feeds/feeds.ts",
        "src/lib/image-widths.ts",
        "src/lib/issues.ts",
        "src/lib/urls.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "**/lib/database.ts",
              "**/lib/media-storage.ts",
              "**/lib/images.ts",
              "**/lib/public-http.ts",
              "**/queries.ts",
              "**/media.ts",
              "**/link-previews.ts",
              "**/site/files.ts",
              "**/commands.ts",
              "**/posts/files.ts",
              "**/lib/http/**",
              "**/handler.ts",
              "**/handler.tsx",
              "**/components/**",
              "**/cli/**",
              "effect/sql",
              "node:fs*"
            ]
          }
        ]
      }
    }
  ]
}
