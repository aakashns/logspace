{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": { "correctness": "error" },
  // Types are checked, not asserted: no casts (`as const` is fine), no `any`, and no `!`.
  "rules": {
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error"
  },
  "env": { "builtin": true },
  // Vendored, minified.
  "ignorePatterns": ["public/datastar.js"],
  // The layers of src/ (see README.md), kept apart: each may only import the ones below it.
  "overrides": [
    {
      // Pure: no database, storage, images, HTTP, or pages.
      "files": ["src/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "**/services/**",
              "**/commands/**",
              "**/queries/**",
              "**/http/**",
              "**/views/**",
              "**/cli/**",
              "effect/sql",
              "node:fs*"
            ]
          }
        ]
      }
    },
    {
      // The read side never writes.
      "files": ["src/queries/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          { "patterns": ["**/commands/**", "**/http/**", "**/views/**", "**/cli/**"] }
        ]
      }
    },
    {
      "files": ["src/commands/**", "src/services/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          { "patterns": ["**/http/**", "**/views/**", "**/cli/**"] }
        ]
      }
    },
    {
      // Pages render what they're given; they don't fetch or write.
      "files": ["src/views/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "**/services/**",
              "**/commands/**",
              "**/http/**",
              "**/cli/**",
              "effect/sql"
            ]
          }
        ]
      }
    }
  ]
}
