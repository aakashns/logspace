{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": { "correctness": "error" },
  // Types are checked, not asserted: no casts (`as const` is fine), no `any`, and no `!`.
  "rules": {
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error"
  },
  "env": { "builtin": true },
  // Vendored, minified.
  "ignorePatterns": ["public/datastar.js"],
  // What each kind of file may import (see ../CONTRIBUTING.md). They're told apart by name, wherever
  // they are: a feature's model, queries.ts, commands.ts, handlers.tsx, and components/.
  "overrides": [
    {
      // Pure: no database, storage, images, network, reads, writes, HTTP, or pages.
      "files": [
        "src/posts/post.ts",
        "src/posts/rows.ts",
        "src/posts/presentation.ts",
        "src/posts/caption.ts",
        "src/posts/format.ts",
        "src/posts/composer/compose.ts",
        "src/posts/feeds/feeds.ts",
        "src/posts/link-previews/link-metadata.ts",
        "src/site/site.ts",
        "src/site/site-images.ts",
        "src/lib/image-widths.ts",
        "src/lib/issues.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "**/lib/database.ts",
              "**/lib/media-storage.ts",
              "**/lib/images.ts",
              "**/lib/public-http.ts",
              "**/queries.ts",
              "**/media.ts",
              "**/link-previews.ts",
              "**/commands.ts",
              "**/files.ts",
              "**/handlers.ts",
              "**/handlers.tsx",
              "**/http/**",
              "**/cli/**",
              "**/components/**",
              "effect/sql",
              "node:fs*"
            ]
          }
        ]
      }
    },
    {
      // The read side never writes.
      "files": [
        "src/**/queries.ts",
        "src/posts/media.ts",
        "src/posts/link-previews/link-previews.ts",
        "src/site/files.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "**/commands.ts",
              "**/files.ts",
              "**/handlers.ts",
              "**/handlers.tsx",
              "**/http/**",
              "**/cli/**",
              "**/components/**"
            ]
          }
        ]
      }
    },
    {
      // Writes and shared services don't know about requests or pages.
      "files": ["src/**/commands.ts", "src/posts/files.ts", "src/lib/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "**/handlers.ts",
              "**/handlers.tsx",
              "**/http/**",
              "**/cli/**",
              "**/components/**"
            ]
          }
        ]
      }
    },
    {
      // Components render what they're given; they don't fetch or write. URLs and the shapes they show come from the model.
      "files": ["src/**/components/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "**/lib/database.ts",
              "**/lib/media-storage.ts",
              "**/lib/images.ts",
              "**/lib/public-http.ts",
              "**/queries.ts",
              "**/media.ts",
              "**/link-previews.ts",
              "**/commands.ts",
              "**/files.ts",
              "**/handlers.ts",
              "**/handlers.tsx",
              "**/http/**",
              "**/cli/**",
              "effect/sql"
            ]
          }
        ]
      }
    },
    {
      // Public pages (and the navbar's controls) don't use the admin's, like the composer's.
      "files": ["src/components/**", "src/posts/components/**", "src/posts/pages/components/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "**/lib/database.ts",
              "**/lib/media-storage.ts",
              "**/lib/images.ts",
              "**/lib/public-http.ts",
              "**/queries.ts",
              "**/media.ts",
              "**/link-previews.ts",
              "**/commands.ts",
              "**/files.ts",
              "**/handlers.ts",
              "**/handlers.tsx",
              "**/http/**",
              "**/cli/**",
              "**/admin/**",
              "**/composer/**",
              "**/manage/**",
              "**/config/**",
              "effect/sql"
            ]
          }
        ]
      }
    },
    {
      // Public routes only read, and show public pages.
      "files": [
        "src/posts/pages/handlers.tsx",
        "src/posts/feeds/handlers.ts",
        "src/posts/link-previews/handlers.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "**/commands.ts",
              "**/files.ts",
              "**/admin/**",
              "**/composer/**",
              "**/manage/**",
              "**/config/**",
              "**/cli/**"
            ]
          }
        ]
      }
    }
  ]
}
