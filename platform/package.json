{
  "name": "logspace",
  "version": "0.7.21",
  "private": true,
  "type": "module",
  "imports": {
    "#jsx/*": "./src/lib/jsx/*.ts"
  },
  "scripts": {
    "dev": "NODE_ENV=development bun --watch src/cli/index.ts start",
    "dev:demo": "bun scripts/dev-demo.ts",
    "start": "NODE_ENV=production bun src/cli/index.ts start",
    "build": "bun scripts/build.ts",
    "test": "bun test",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install --with-deps chromium webkit",
    "typecheck": "bun check",
    "lint": "oxlint",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "ready": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "new-id": "bun -e \"let a = '0123456789abcdefghijklmnopqrstuvwxyz', id = ''; while (id.length < 10) { let [b] = crypto.getRandomValues(new Uint8Array(1)); if (b < 252) id += a[b % 36] } console.log(id)\"",
    "count-lines": "bun scripts/count-lines.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.6",
    "@effect/sql-sqlite-bun": "4.0.6",
    "effect": "4.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "oxlint": "^1.88.0"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
