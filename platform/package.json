{
  "name": "logspace",
  "version": "0.4.4",
  "private": true,
  "type": "module",
  "imports": {
    "#jsx/*": "./src/jsx/*.ts"
  },
  "scripts": {
    "dev": "NODE_ENV=development bun --watch src/main.ts start",
    "start": "NODE_ENV=production bun src/main.ts start",
    "build": "bun scripts/build.ts",
    "test": "bun test",
    "typecheck": "bun check",
    "lint": "oxlint",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "new-id": "bun -e \"let a = '0123456789abcdefghijklmnopqrstuvwxyz', id = ''; while (id.length < 10) { let [b] = crypto.getRandomValues(new Uint8Array(1)); if (b < 252) id += a[b % 36] } console.log(id)\"",
    "count-lines": "bun scripts/count-lines.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.6",
    "@effect/sql-sqlite-bun": "4.0.6",
    "effect": "4.0.6"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "oxlint": "^1.88.0"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
