{
  // The build and the binary's tests use Bun's APIs. Bun's types also change the global Blob and
  // File, which the app's code doesn't match, so they're only for these.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node", "bun"]
  },
  "include": ["build.ts", "smoke-test.ts", "setup-test.ts"],
  "exclude": []
}
